# =============================================================================
# QONFORME — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# =============================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Lien de paiement par virement (facultatif) ---
# Secret de dérivation des jetons des pages de règlement (/regler/<jeton>).
# Absent : la clé service_role ci-dessus en tient lieu. À fixer une fois pour
# toutes : le changer rend inutilisables les liens déjà envoyés par email.
# PAYMENT_LINK_SECRET=au-moins-32-caracteres-aleatoires

# --- Plateforme agréée : Super PDP (réception des factures fournisseurs) ---
# Application OAuth de Qonforme chez Super PDP (« Applications », type « confidentielle »,
# URL de redirection : https://qonforme.fr/api/pa/superpdp/callback). Deux modes, comme Stripe :
# production sans suffixe, bac à sable (comptes d'essai) avec _TEST. Variables absentes pour un
# mode : le raccordement n'est pas proposé à ces comptes (import manuel seulement).
# SUPERPDP_CLIENT_ID=...
# SUPERPDP_CLIENT_SECRET=...
# SUPERPDP_CLIENT_ID_TEST=...
# SUPERPDP_CLIENT_SECRET_TEST=...
# Clé de chiffrement des jetons OAuth (facultatif, sinon la clé service_role). La changer oblige
# chaque artisan à autoriser Qonforme à nouveau.
# PA_TOKEN_SECRET=au-moins-32-caracteres-aleatoires

# --- Stripe ---
# Deux modes (DECISIONS-STRATEGIQUES.md § 14) : la production (tous les vrais clients) et le
# bac à sable (comptes d'essai cochés dans Admin › Paiements). Mêmes noms, suffixe _TEST pour
# le bac à sable. Aucun interrupteur général : un compte d'essai paie en bac à sable, tous les
# autres en production.
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SECRET_KEY_TEST=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_TEST=pk_test_...
STRIPE_WEBHOOK_SECRET_TEST=whsec_...

# Webhook (un par mode, même adresse SANS www : https://qonforme.fr/api/webhooks/stripe).
# Événements : checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid, invoice.payment_failed
#
# Prix récurrents en euros, grille du 19/10/2026 : Essentiel 24 €/mois et 240 €/an,
# Artisan 34 €/mois et 340 €/an. Tant que VAT_COLLECTED vaut false (lib/stripe/plans.ts),
# le prix est le prix payé, sans TVA ajoutée.
STRIPE_PRICE_ESSENTIEL_MONTHLY=price_...
STRIPE_PRICE_ESSENTIEL_YEARLY=price_...
STRIPE_PRICE_ESSENTIEL_MONTHLY_TEST=price_...
STRIPE_PRICE_ESSENTIEL_YEARLY_TEST=price_...
# Artisan : renseigner LES DEUX prix de production met la formule en vente (bouton de paiement
# sur Tarifs et dans les fenêtres Artisan). Vides : affichée « bientôt », non vendue au public
# (un compte d'essai peut quand même l'acheter dès que ses deux prix _TEST existent).
# Valeur lue au build (next.config.mjs) : redéployer après les avoir renseignés.
STRIPE_PRICE_ARTISAN_MONTHLY=
STRIPE_PRICE_ARTISAN_YEARLY=
STRIPE_PRICE_ARTISAN_MONTHLY_TEST=
STRIPE_PRICE_ARTISAN_YEARLY_TEST=
# STRIPE_TAX_RATE_ID n'est plus utilisé : la TVA, quand elle sera collectée, vient de Stripe Tax.

# --- Resend (emails transactionnels) ---
RESEND_API_KEY=re_...
# OBLIGATOIRE : adresse d'envoi depuis un domaine vérifié sur resend.com/domains
# Sans cette variable, les emails échouent silencieusement pour les adresses non vérifiées
RESEND_FROM_EMAIL=noreply@qonforme.fr
# Optionnel : redirige TOUS les emails vers cette adresse (mode sandbox de test)
# Supprimer cette ligne en production
# RESEND_TEST_EMAIL=test@example.com

# --- PPF / Chorus Pro (Portail Public de Facturation) ---
PPF_API_URL=https://sandbox.api.chorus-pro.gouv.fr
PPF_CLIENT_ID=
PPF_CLIENT_SECRET=

# --- INSEE Sirene (recherche SIREN) ---
INSEE_API_KEY=

# --- Application ---
NEXT_PUBLIC_APP_URL=https://qonforme.fr

# --- Admin ---
# Credentials de connexion à l'espace admin (/admin/login)
# Totalement indépendant des comptes utilisateurs Supabase
ADMIN_EMAIL=admin@qonforme.fr
ADMIN_PASSWORD=mot-de-passe-tres-securise
# Secret pour signer le cookie de session (min. 32 caractères aléatoires)
ADMIN_COOKIE_SECRET=changez-moi-avec-32-caracteres-aleatoires-minimum

# --- Cron (relances automatiques) ---
# Secret partagé entre cron-job.org et l'API /api/cron/send-reminders
# Configurer dans cron-job.org : Header "Authorization" = "Bearer {valeur ci-dessous}"
# Générer avec : openssl rand -hex 32
CRON_SECRET=changez-moi-avec-une-chaine-aleatoire-secrete

# --- Google Search Console ---
# Code de vérification (meta tag) — récupérer sur https://search.google.com/search-console
# Seulement la valeur, pas la balise complète (ex: "abc123def456")
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Onglet SEO de l'admin (/admin/seo, PLAN-SEO-INTERNE-2026-10.md) ---
# Tâches planifiées : cron-job.org appelle GET /api/cron/seo toutes les 15 minutes
# avec l'en-tête « Authorization: Bearer {CRON_SECRET} ».
# Compte de service Google Cloud (JSON complet, tel quel ou en base64), avec l'API
# Search Console activée, ajouté comme utilisateur de la propriété dans Search Console.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Propriété Search Console (par défaut sc-domain:qonforme.fr)
GSC_PROPERTY=
# Clé d'API Google Cloud avec l'API PageSpeed Insights activée (facultative : sans clé, quota très faible)
PAGESPEED_API_KEY=
# Visibilité IA : clés des moteurs suivis (seuls les moteurs configurés sont interrogés)
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=
# DataForSEO : volumes de recherche des mots-clés et Aperçu IA de Google
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# OpenSEO (app.openseo.so › Settings › API keys, clé « oseo_… ») : volumes, difficulté, CPC et intention des mots-clés,
# prioritaire sur DataForSEO. La clé est personnelle et ne peut pas être limitée à la lecture : jamais ailleurs que dans Vercel.
OPENSEO_API_KEY=
# Facultatif : projet OpenSEO du site (sinon retrouvé par son domaine, qonforme.fr)
OPENSEO_PROJECT_ID=

# --- Blog IA (Gemini) ---
# Clé API Google AI Studio pour la génération de contenu blog
GEMINI_API_KEY=
# true = publication automatique des articles IA, false = brouillon (review admin)
BLOG_AUTO_PUBLISH=true

# --- PostHog Analytics ---
# Project API Key depuis https://us.posthog.com/settings/project
# Sans cette clé, rien n'est envoyé. Chargé après accord du bandeau de cookies seulement ;
# l'enregistrement des sessions (masqué, lib/replay.ts) demande aussi Session replay activé dans PostHog.
NEXT_PUBLIC_POSTHOG_KEY=
# Personal API Key (server-side, pour le dashboard admin)
# Créer sur https://us.posthog.com/settings/user-api-keys (scope: Query read)
POSTHOG_PERSONAL_API_KEY=

# --- Démarchage (désactivé par décision, DECISIONS-STRATEGIQUES.md § 2) ---
# Les tâches de prospection ne font rien tant que cette variable ne vaut pas « true »
PROSPECTION_ENABLED=

# Discussion avec Christophe (bulle de contact) : adresse qui reçoit les nouveaux messages (défaut : RESEND_FROM_EMAIL), clé des liens de conversation (défaut : clé service_role)
# SUPPORT_NOTIFY_EMAIL=contact@qonforme.fr
# SUPPORT_CHAT_SECRET=
